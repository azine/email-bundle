{
    "name": "azine/email-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for multipart notifications, newsletters, email web views and account emails.",
    "keywords": [
        "email",
        "newsletter",
        "notification",
        "symfony",
        "web view"
    ],
    "homepage": "https://github.com/azine/email-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Azine IT Services AG",
            "email": "github@azine-it.ch"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^3.3 || ^4.0",
        "friendsofsymfony/user-bundle": "^4.1",
        "knplabs/knp-paginator-bundle": "^6.0",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/extra-bundle": "^3.14",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.15",
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpunit/phpunit": "^12.0",
        "symfony/phpunit-bridge": "^7.4"
    },
    "suggest": {
        "azine/emailupdateconfirmation-bundle": "Adds confirmation of user email-address changes.",
        "ext-gd": "Allows generated GD images to be embedded into outgoing email."
    },
    "autoload": {
        "psr-4": {
            "Azine\\EmailBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azine\\EmailBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
